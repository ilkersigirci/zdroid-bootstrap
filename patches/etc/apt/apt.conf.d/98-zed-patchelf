// Fixes the com.termux paths in the ELF files each dpkg invocation
// installs. The stamp marks the invocation's start, so the hook sees
// exactly the files it changed. See
// /data/data/com.zdroid/files/usr/etc/apt/zed-patchelf-hook.sh.
DPkg::Pre-Invoke {
    "/data/data/com.zdroid/files/usr/bin/touch /data/data/com.zdroid/files/usr/var/lib/dpkg/zed-patchelf.stamp";
};
DPkg::Post-Invoke {
    "/data/data/com.zdroid/files/usr/etc/apt/zed-patchelf-hook.sh || true";
};
