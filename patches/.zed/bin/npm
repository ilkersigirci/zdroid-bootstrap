#!/data/data/com.zdroid/files/usr/bin/sh
# Comes first on Zdroid's PATH. Runs the real npm with the settings below,
# then etc/apt/zed-launcher-gen.sh, which makes the Linux binaries npm
# packages ship run here.
REAL_NPM_JS=/data/data/com.zdroid/files/usr/lib/node_modules/npm/bin/npm-cli.js
NODE=/data/data/com.zdroid/files/usr/bin/node
HOOK=/data/data/com.zdroid/files/usr/etc/apt/zed-launcher-gen.sh
TERMUX_EXEC=/data/data/com.zdroid/files/usr/lib/libtermux-exec.so
# libtermux-exec.so rewrites Linux-style shebangs (#!/usr/bin/env node,
# #!/bin/sh) to $PREFIX/bin, which npm scripts need: Android has no
# /usr/bin/env. Zdroid leaves LD_PRELOAD out of its own environment, which
# SSH sessions inherit, so it's set here, for npm's processes only.
if [ ! -x "$NODE" ] || [ ! -f "$REAL_NPM_JS" ]; then
    echo "zed-npm: real npm or node missing" >&2
    exit 1
fi
if [ -f "$TERMUX_EXEC" ]; then
    export LD_PRELOAD="$TERMUX_EXEC"
fi
# Install the musl Linux builds of packages' native binaries. npm compares
# a package's `os` with process.platform, android for Termux's Node, and
# can't tell bionic's libc apart, so it would skip them (Claude Code's
# claude-code-linux-arm64-musl, Codex's codex-linux-arm64). The bundled
# $PREFIX/lib/ld-musl-aarch64.so.1 and the launcher generator run them.
export npm_config_os=linux
export npm_config_libc=musl
"$NODE" "$REAL_NPM_JS" "$@"
RC=$?
if [ -x "$HOOK" ]; then
    "$HOOK" 2>&1 || true
fi
exit $RC
